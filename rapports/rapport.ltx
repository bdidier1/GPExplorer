\section{Services fournis}

\subsection{Services de restauration et rafraîchissement}

\begin{itemize}
    \item \textbf{Stands de nourriture} : De nombreux stands de nourriture seront installés dans la zone. Ils seront diversifiés afin de plaire à tout le monde (de la viennoiserie aux spécialités plus élaborées).
    
    \item \textbf{Stands de boissons} : Des stands de boissons à thèmes et des stands d'eau gratuits seront éparpillés aux quatre coins de l'évènement pour permettre de s'hydrater à tout moment.
    
    \item \textbf{Stand ``Ciao Kombucha''} : Des stands de Ciao Kombucha, marque de boisson du créateur du GP Explorer Squeezie, seront présents un peu partout et il y aura aussi des distributions gratuites de quoi ravir tout le monde.
\end{itemize}

\subsection{Services de souvenirs}

\begin{itemize}
    \item \textbf{Stands de merchandising} : Vente de produits dérivés liés à l'événement comme des casquettes, des maillots ou des drapeaux aux couleurs de l'écurie que vous supportez.
\end{itemize}

\subsection{Services de rencontres}

\begin{itemize}
    \item \textbf{Stands de dédicaces} : Divers stands avec des célébrités liées à l'événement pour les rencontrer.
    
    \item \textbf{Concerts} : Des concerts auront lieu le vendredi et le samedi à des endroits spécifiques avec les artistes français les plus convoités.
\end{itemize}

\subsection{Services de confort}

\begin{itemize}
    \item \textbf{Parking} : Des espaces gratuits pour accueillir les visiteurs seront mis à disposition pour garantir une bonne organisation.
    
    \item \textbf{Camping} : Des zones seront prévues pour que les visiteurs puissent y dormir, évitant ainsi aux personnes venues de loin des contraintes de déplacement.
\end{itemize}

\subsection{Services de loisirs}

\begin{itemize}
    \item \textbf{Grande roue} : Une grande roue sera mise à disposition offrant une vue sur le circuit et sur l'ensemble du site.
    
    \item \textbf{Simulateur F1} : Des simulateurs de F1 seront à disposition pour faire ressentir aux visiteurs les sensations qu'éprouve un pilote lors d'une course.
    
    \item \textbf{Karting} : Un circuit de karting sera présent dans l'événement pour permettre aux visiteurs de tester leurs capacités de pilotage.
\end{itemize}

